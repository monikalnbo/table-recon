{
  "name": "table-recon-desktop",
  "version": "1.0.0",
  "description": "双表核对 桌面版（Windows / macOS / Linux）",
  "main": "main.mjs",
  "author": "monikalnbo",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "test": "node test/golden-recon.mjs && node ../excel-mcp-js/selftest.mjs",
    "dist": "electron-builder",
    "smoke": "electron test-sdk-electron.mjs",
    "setup": "node scripts/sync-packages.mjs && npm install"
  },
  "devDependencies": {
    "electron": "^37.10.3",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.monikalnbo.table-recon",
    "productName": "双表核对",
    "artifactName": "TableRecon-${version}-${os}-${arch}.${ext}",
    "files": [
      "main.mjs",
      "preload.cjs",
      "app.html",
      "main/**"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        "portable"
      ],
      "artifactName": "TableRecon-Portable-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "mac": {
      "target": [
        "zip"
      ],
      "category": "public.app-category.productivity",
      "identity": null
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Utility"
    },
    "extraMetadata": {
      "name": "双表核对"
    },
    "asarUnpack": [
      "**/*.node"
    ]
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "^0.84.3",
    "@sinclair/typebox": "^0.34.52",
    "recon-js": "file:./app-src/recon-js",
    "excel-mcp-js": "file:./app-src/excel-mcp-js"
  },
  "type": "module"
}